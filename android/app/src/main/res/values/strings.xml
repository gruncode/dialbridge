<resources>
    <string name="app_name">DialBridge</string>

    <string name="intro">Click a phone number in your computer\'s browser and this phone opens its dialer with the number ready. Enter the same topic here and in the browser extension.</string>

    <string name="label_topic">Topic</string>
    <string name="hint_topic">tap Generate</string>
    <string name="hint_topic_explain">A private channel name shared with the browser extension. Anyone who knows it can make this phone ring, so keep it to yourself.</string>

    <string name="label_server">Server</string>
    <string name="hint_server">https://ntfy.sh</string>

    <string name="label_token">Access token</string>
